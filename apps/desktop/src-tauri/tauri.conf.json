{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ubms",
  "version": "0.1.3",
  "identifier": "io.github.ubms.desktop",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ubms",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 ubms contributors",
    "license": "MIT",
    "shortDescription": "BMS viewer and configurator",
    "longDescription": "Monitor and configure battery management systems, active balancers and meters over Bluetooth and serial ports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
